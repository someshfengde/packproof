# Demo mode is deterministic and does not claim to analyze uploaded photos.
AI_MODE=demo_fixture

# Vertex mode: set AI_MODE=live_vertex and use Application Default Credentials.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL_ID=gemini-3.5-flash

# Gemini Developer API mode: set AI_MODE=live_gemini_api and keep the key server-side.
# AI Studio Starter injects GEMINI_API_KEY as a server secret.
# GEMINI_API_KEY=your-server-side-key
# GEMINI_API_MODEL_ID=gemini-3.5-flash-lite
# CASE_SIGNING_SECRET=load-from-secret-manager-in-production

# Static Firebase Hosting mode (public web config only; never put a Gemini API key here).
# Set these for a Vite build: VITE_PACKPROOF_PROVIDER=firebase_ai_logic.
# VITE_FIREBASE_API_KEY=public-firebase-web-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APPCHECK_SITE_KEY=public-recaptcha-enterprise-site-key
# For localhost only, register the printed debug token in Firebase App Check:
# VITE_FIREBASE_APPCHECK_DEBUG=true
