{
  "name": "packproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:firebase": "node scripts/check-firebase-env.mjs && tsc --noEmit && vite build",
    "deploy:firebase": "npm run build:firebase && npx firebase-tools deploy --only hosting",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "express": "^5.1.0",
    "firebase": "^13.0.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  }
}
